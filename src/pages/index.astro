---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Carlos Limón Ledesma | Software Architect & Lead Developer">

<div class="max-w-6xl mx-auto px-6">

  <!-- Hero Section -->
  <section class="min-h-screen flex flex-col justify-center pt-20 pb-20 relative overflow-hidden">
    <!-- Background decorative elements -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-brand-500/10 rounded-full blur-3xl animate-float"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-teal-500/10 rounded-full blur-3xl animate-float animation-delay-300"></div>
    </div>
    
    <div class="text-center relative z-10 animate-on-scroll">
      <p class="text-brand-400 font-mono text-sm mb-4 tracking-wider uppercase animate-fade-in">Software Architect · Lead Developer</p>
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold mb-6 leading-tight font-display animate-fade-in-up animation-delay-100">
        Carlos Limón Ledesma
      </h1>
      <p class="max-w-3xl mx-auto text-lg md:text-xl text-surface-300 mb-10 leading-relaxed animate-fade-in-up animation-delay-200">
        Software architect focused on modern C++, Linux, distributed systems, CI/CD automation, software quality, engineering excellence and scalable product development.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mt-8 animate-fade-in-up animation-delay-300">
        <a href="https://github.com/Calileus" target="_blank" rel="noopener noreferrer" class="link-button" aria-label="GitHub Profile">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          GitHub
        </a>
        <a href="https://linkedin.com/in/calileus" target="_blank" rel="noopener noreferrer" class="link-button-secondary" aria-label="LinkedIn Profile">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
        </a>
        <a href="mailto:carloslimonledesma@gmail.com" class="link-button-secondary" aria-label="Email Contact">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          Email
        </a>
      </div>
      <p class="mt-10 text-surface-500 font-mono text-sm animate-fade-in-up animation-delay-400">Querétaro, Mexico</p>
    </div>
    
    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce" aria-hidden="true">
      <svg class="w-6 h-6 text-surface-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </section>

  <!-- About Section -->
  <section class="py-20" aria-labelledby="about-heading">
    <h2 id="about-heading" class="section-title animate-on-scroll">About</h2>
    <div class="card max-w-4xl animate-on-scroll">
      <p class="text-surface-300 leading-relaxed text-lg">
        Software Architect and Lead Developer with 10+ years of experience delivering complex software solutions and leading multidisciplinary engineering teams. Specialized in modern C++, cross-platform development, repository governance, automated quality systems and software lifecycle management.
      </p>
      <p class="mt-4 text-surface-400 leading-relaxed">
        Currently serving as Software Architect for Automotive Radar Logic Model at AUMOVIO/Continental Autonomous Mobility, leading a team of 14 engineers from quotation through production deployment. Founder of <a href="https://github.com/ObsidianHonorCoders" target="_blank" rel="noopener noreferrer" class="text-brand-400 hover:underline font-medium">Obsidian Honor Coders</a> — an engineering community promoting modern C++ and software quality standards.
      </p>
    </div>
  </section>

  <!-- Key Achievements -->
  <section class="py-20" aria-labelledby="achievements-heading">
    <h2 id="achievements-heading" class="section-title animate-on-scroll">Key Achievements</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="stat-card" style="animation-delay: 100ms;">
        <p class="stat-value">14</p>
        <p class="stat-label">Engineer Multidisciplinary Team Leadership</p>
      </div>
      <div class="stat-card" style="animation-delay: 200ms;">
        <p class="stat-value">58+</p>
        <p class="stat-label">Software Releases Delivered</p>
      </div>
      <div class="stat-card" style="animation-delay: 300ms;">
        <p class="stat-value">12</p>
        <p class="stat-label">Customer-Facing Production Releases</p>
      </div>
      <div class="stat-card" style="animation-delay: 400ms;">
        <p class="stat-value">60%</p>
        <p class="stat-label">Reduction in Review Effort Through Automation</p>
      </div>
      <div class="stat-card" style="animation-delay: 500ms;">
        <p class="stat-value">80%</p>
        <p class="stat-label">Delivery Package Size Reduction (Legacy Refactor)</p>
      </div>
      <div class="stat-card" style="animation-delay: 600ms;">
        <p class="stat-value">2,500+</p>
        <p class="stat-label">Commits Across Multiple Repositories</p>
      </div>
      <div class="stat-card" style="animation-delay: 700ms;">
        <p class="stat-value">279+</p>
        <p class="stat-label">Pull Request Reviews</p>
      </div>
      <div class="stat-card" style="animation-delay: 800ms;">
        <p class="stat-value">241+</p>
        <p class="stat-label">Merged Pull Requests</p>
      </div>
      <div class="stat-card" style="animation-delay: 900ms;">
        <p class="stat-value">17</p>
        <p class="stat-label">Contributors Onboarded & Mentored</p>
      </div>
    </div>
  </section>

  <!-- Technical Skills -->
  <section class="py-20" aria-labelledby="skills-heading">
    <h2 id="skills-heading" class="section-title animate-on-scroll">Technical Skills</h2>
    <div class="space-y-12">
      <div class="animate-on-scroll" style="animation-delay: 100ms;">
        <h3 class="text-xl font-semibold text-brand-400 mb-6 font-display">Core Languages</h3>
        <div class="flex flex-wrap gap-3">
          <span class="skill-tag">C++20</span>
          <span class="skill-tag">C++17</span>
          <span class="skill-tag">C</span>
          <span class="skill-tag">Python</span>
          <span class="skill-tag">MATLAB</span>
        </div>
      </div>
      <div class="animate-on-scroll" style="animation-delay: 200ms;">
        <h3 class="text-xl font-semibold text-brand-400 mb-6 font-display">Architecture & Design</h3>
        <div class="flex flex-wrap gap-3">
          <span class="skill-tag">Software Architecture</span>
          <span class="skill-tag">Distributed Systems</span>
          <span class="skill-tag">Object-Oriented Design</span>
          <span class="skill-tag">Design Patterns</span>
          <span class="skill-tag">SDLC</span>
          <span class="skill-tag">Component-Based Architecture</span>
          <span class="skill-tag">Event-Driven Systems</span>
        </div>
      </div>
      <div class="animate-on-scroll" style="animation-delay: 300ms;">
        <h3 class="text-xl font-semibold text-brand-400 mb-6 font-display">Quality Engineering</h3>
        <div class="flex flex-wrap gap-3">
          <span class="skill-tag">MISRA C/C++</span>
          <span class="skill-tag">Static Analysis</span>
          <span class="skill-tag">clang-format</span>
          <span class="skill-tag">Code Reviews</span>
          <span class="skill-tag">GoogleTest</span>
          <span class="skill-tag">Automated Quality Gates</span>
        </div>
      </div>
      <div class="animate-on-scroll" style="animation-delay: 400ms;">
        <h3 class="text-xl font-semibold text-brand-400 mb-6 font-display">DevOps & Tooling</h3>
        <div class="flex flex-wrap gap-3">
          <span class="skill-tag">Git & GitHub</span>
          <span class="skill-tag">GitHub Actions</span>
          <span class="skill-tag">CI/CD</span>
          <span class="skill-tag">Docker</span>
          <span class="skill-tag">Dev Containers</span>
          <span class="skill-tag">CMake</span>
          <span class="skill-tag">Doxygen</span>
          <span class="skill-tag">protobuf</span>
        </div>
      </div>
      <div class="animate-on-scroll" style="animation-delay: 500ms;">
        <h3 class="text-xl font-semibold text-brand-400 mb-6 font-display">Platforms & Domains</h3>
        <div class="flex flex-wrap gap-3">
          <span class="skill-tag">Linux</span>
          <span class="skill-tag">Windows</span>
          <span class="skill-tag">Cross-Platform Development</span>
          <span class="skill-tag">Automotive (Radar)</span>
          <span class="skill-tag">FMI/Simulation</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Open Source Projects -->
  <section class="py-20" aria-labelledby="oss-heading">
    <h2 id="oss-heading" class="section-title animate-on-scroll">Open Source — Obsidian Honor Coders</h2>
    <p class="text-surface-400 mb-10 max-w-3xl animate-on-scroll" style="animation-delay: 100ms;">Founder & maintainer of <a href="https://github.com/ObsidianHonorCoders" target="_blank" rel="noopener noreferrer" class="text-brand-400 hover:underline font-medium">Obsidian Honor Coders</a> — an engineering community focused on modern C++ development, engineering standards, software quality, and collaborative development practices.</p>
    <div class="grid md:grid-cols-3 gap-6">
      <a href="https://github.com/ObsidianHonorCoders/ohc-template-repo" target="_blank" rel="noopener noreferrer" class="card-interactive animate-on-scroll" style="animation-delay: 200ms;" aria-label="View ohc-template-repo on GitHub">
        <div class="flex items-center gap-3 mb-4">
          <svg class="w-8 h-8 text-brand-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          <h3 class="font-bold text-lg group-hover:text-brand-400 transition-colors font-display">ohc-template-repo</h3>
        </div>
        <p class="text-surface-400 mb-4">Reusable development template featuring Dev Containers, CMake, GoogleTest, GitHub Actions, automated code quality controls, documentation tooling, and cross-platform CI/CD.</p>
        <span class="text-xs font-mono text-brand-400">Template · CMake · CI/CD · Quality Gates</span>
      </a>
      <a href="https://github.com/ObsidianHonorCoders/inheritance-chess" target="_blank" rel="noopener noreferrer" class="card-interactive animate-on-scroll" style="animation-delay: 300ms;" aria-label="View inheritance-chess on GitHub">
        <div class="flex items-center gap-3 mb-4">
          <svg class="w-8 h-8 text-brand-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          <h3 class="font-bold text-lg group-hover:text-brand-400 transition-colors font-display">inheritance-chess</h3>
        </div>
        <p class="text-surface-400 mb-4">A modular C++20 chess engine demonstrating polymorphic object-oriented design, component-based architecture, event-driven systems, and cross-platform automated testing.</p>
        <span class="text-xs font-mono text-brand-400">C++20 · Chess Engine · Clean Architecture</span>
      </a>
      <a href="https://github.com/ObsidianHonorCoders/easy-examples" target="_blank" rel="noopener noreferrer" class="card-interactive animate-on-scroll" style="animation-delay: 400ms;" aria-label="View easy-examples on GitHub">
        <div class="flex items-center gap-3 mb-4">
          <svg class="w-8 h-8 text-brand-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          <h3 class="font-bold text-lg group-hover:text-brand-400 transition-colors font-display">easy-examples</h3>
        </div>
        <p class="text-surface-400 mb-4">Educational modern C++ reference repository featuring Win32 programming, multithreading, smart pointers, and STL best practices.</p>
        <span class="text-xs font-mono text-brand-400">Learning · Win32 · Multithreading · STL</span>
      </a>
    </div>
  </section>

  <!-- Experience Timeline -->
  <section class="py-20" aria-labelledby="experience-heading">
    <h2 id="experience-heading" class="section-title animate-on-scroll">Experience</h2>
    <div class="space-y-8 max-w-4xl">
      <div class="card relative pl-12 border-l-4 border-brand-500 animate-on-scroll" style="animation-delay: 100ms;">
        <div class="absolute left-0 top-6 w-4 h-4 bg-brand-500 rounded-full border-4 border-surface-950"></div>
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0">
            <p class="text-brand-400 font-mono text-sm">Apr 2022 — Present</p>
          </div>
          <div>
            <h3 class="font-bold text-xl font-display">AUMOVIO / Continental Autonomous Mobility</h3>
            <p class="text-brand-400 font-medium mb-2">Software Architect · Repository Maintainer · Lead Developer</p>
            <ul class="space-y-2 text-surface-300 text-sm" role="list">
              <li>• Served as Software Architect, Package Owner, Repository Maintainer, and Integration Owner for Automotive Radar Logic Model products</li>
              <li>• Led end-to-end development of a greenfield Automotive Radar Logic Model from quotation, planning, architecture definition, implementation, validation, customer integration, and production deployment</li>
              <li>• Defined cross-platform (Windows/Linux) software architecture, package decomposition, branching strategy, versioning model, release process, engineering workflows, and repository governance standards</li>
              <li>• Architected an object-processing pipeline responsible for detection-list processing, object tracking, object classification integration, and customer object-list generation</li>
              <li>• Developed protobuf-based interfaces and simulation integration capabilities supporting customer-defined data exchanges and FMI-compliant workflows</li>
              <li>• Served as primary technical reviewer enforcing MISRA C/C++, clang-format, code review standards, repository quality gates, and software engineering best practices</li>
              <li>• Designed and implemented GitHub Actions workflows covering build validation, formatting verification, testing, and release quality controls, reducing engineering review effort by ~60%</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="card relative pl-12 border-l-4 border-surface-700 animate-on-scroll" style="animation-delay: 200ms;">
        <div class="absolute left-0 top-6 w-4 h-4 bg-surface-700 rounded-full border-4 border-surface-950"></div>
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0">
            <p class="text-surface-400 font-mono text-sm">2015–2018 · 2020–2022</p>
          </div>
          <div>
            <h3 class="font-bold text-xl font-display">Polytechnic University of Querétaro / Autonomous University of Querétaro</h3>
            <p class="text-surface-400 font-medium mb-2">University Professor · Facilitator</p>
            <ul class="space-y-2 text-surface-300 text-sm" role="list">
              <li>• Taught C/C++ programming, linear algebra, differential equations, vector calculus, and formal logic</li>
              <li>• Developed automated grading and contest-management software reducing evaluation effort</li>
              <li>• Served as Academic Manager, preparing examination content for the Mexican Logic Olympiad</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="card relative pl-12 border-l-4 border-surface-700 animate-on-scroll" style="animation-delay: 300ms;">
        <div class="absolute left-0 top-6 w-4 h-4 bg-surface-700 rounded-full border-4 border-surface-950"></div>
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0">
            <p class="text-surface-400 font-mono text-sm">2014–2016</p>
          </div>
          <div>
            <h3 class="font-bold text-xl font-display">REXAM / IMPULSE TELECOM / Sancorzep Group / REGULES</h3>
            <p class="text-surface-400 font-medium mb-2">Software Development Consultant</p>
            <ul class="space-y-2 text-surface-300 text-sm" role="list">
              <li>• Delivered custom enterprise software solutions for asset inventory management and operational support systems using SQL, C++ and WinAPI technologies</li>
              <li>• Managed the complete software lifecycle from customer requirements gathering and solution design through coding, deployment, user manual documentation, user training and maintenance</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Education & Certifications -->
  <section class="py-20" aria-labelledby="education-heading">
    <h2 id="education-heading" class="section-title animate-on-scroll">Education & Certifications</h2>
    <div class="grid md:grid-cols-2 gap-6 max-w-4xl">
      <div class="card animate-on-scroll" style="animation-delay: 100ms;">
        <h3 class="font-bold text-lg mb-2 font-display">Master of Science in Mathematics</h3>
        <p class="text-brand-400 font-medium mb-1">Universidad Nacional Autónoma de México (UNAM)</p>
